# ==============================================================================
# OpenSource Radar — Environment Configuration Template
# Copy this file to .env and configure your values.
# NEVER commit the active .env file to version control.
# ==============================================================================

# GitHub API Configuration
# Optional for basic public browsing (60 req/hr), strongly recommended for authenticated usage (5,000 req/hr)
GITHUB_TOKEN=
GITHUB_API_BASE=https://api.github.com

# AI Provider Configuration (Optional)
# The application functions completely without AI credentials (falling back to deterministic analysis)
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Database Configuration
# Defaults to SQLite database in the local data directory
DATABASE_URL=sqlite:///data/opensource_radar.db

# Application & Logging
APP_ENV=development
LOG_LEVEL=INFO
CACHE_TTL_SECONDS=3600
RATE_LIMIT_PER_MINUTE=30

# Telegram Auto-Notifications (Optional)
# Create a bot via @BotFather to get your token, and get your Chat ID via @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALERT_SCORE_THRESHOLD=75
